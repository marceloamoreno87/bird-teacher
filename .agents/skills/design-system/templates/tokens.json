{
  "version": 1,
  "defaultTheme": "light",
  "tokens": {
    "palette": {
      "paper": "#f7f8fa",
      "white": "#ffffff",
      "ink": "#172033",
      "muted": "#536176",
      "line": "#7c889b",
      "brand": "#1849a9",
      "brand-light": "#a9c5ff",
      "night": "#111827",
      "panel": "#1f2937",
      "soft": "#b9c4d4",
      "dark-line": "#71829a",
      "danger": "#a32121",
      "danger-light": "#ffb4b4",
      "success": "#14643d",
      "success-light": "#96e0b7"
    },
    "space": {
      "xs": "0.25rem",
      "sm": "0.5rem",
      "md": "1rem",
      "lg": "1.5rem",
      "xl": "2.5rem"
    },
    "font": {
      "body": "system-ui, sans-serif",
      "small": "0.875rem",
      "base": "1rem",
      "title": "clamp(1.75rem, 4vw, 2.75rem)",
      "leading": "1.5"
    },
    "radius": {
      "control": "0.5rem",
      "panel": "0.75rem"
    },
    "size": {
      "content": "64rem",
      "control": "2.75rem"
    },
    "border": {
      "width": "1px",
      "focus": "3px"
    },
    "motion": {
      "fast": "120ms"
    }
  },
  "themes": {
    "light": {
      "background": "{palette.paper}",
      "surface": "{palette.white}",
      "foreground": "{palette.ink}",
      "muted": "{palette.muted}",
      "line": "{palette.line}",
      "accent": "{palette.brand}",
      "on-accent": "{palette.white}",
      "focus": "{palette.brand}",
      "danger": "{palette.danger}",
      "success": "{palette.success}"
    },
    "dark": {
      "background": "{palette.night}",
      "surface": "{palette.panel}",
      "foreground": "{palette.paper}",
      "muted": "{palette.soft}",
      "line": "{palette.dark-line}",
      "accent": "{palette.brand-light}",
      "on-accent": "{palette.night}",
      "focus": "{palette.brand-light}",
      "danger": "{palette.danger-light}",
      "success": "{palette.success-light}"
    }
  }
}
